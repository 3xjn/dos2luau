check("finite MZ allocation leaves free DOS paragraphs", function()
	local c: any, b: any = CPU.new(), Bus.new()
	HLE.new(b)
	Loader.load(c, b, {
		format = "mz",
		image = string.char(0xf4),
		entryCS = 0,
		entryIP = 0,
		initialSS = 0,
		initialSP = 0x100,
		minExtraParagraphs = 4,
		maxExtraParagraphs = 8,
		relocations = {},
	})
	eq(c.initialParagraphs, 25)
	eq(b:read16(c.pspSegment * 16 + 2), 0x9fff)
	CPU.setReg(c, 0, 16, 0x4800)
	CPU.setReg(c, 3, 16, 0xffff)
	interrupt(c, b, 0x21)
	eq(bit32.band(c.flags, 1), 1)
	assert(CPU.getReg(c, 3, 16) > 0)
end)
check("graphics BIOS scroll clears CGA banks without text attributes", function()
	local c, b, h = guest()
	local v: any = Video.new(b, { headless = true })
	h.video = v
	v:setMode(4)
	b:write8(0xb8000, 255)
	b:write8(0xba000, 255)
	CPU.setReg(c, 0, 16, 0x0600)
	CPU.setReg(c, 3, 16, 0)
	CPU.setReg(c, 1, 16, 0)
	CPU.setReg(c, 2, 16, 0x1827)
	interrupt(c, b, 0x10)
	eq(b:read8(0xb8000), 0)
	eq(b:read8(0xba000), 0)
	eq(b:read16(0x463), 0x3d4)
	CPU.setReg(c, 0, 16, 0x1a00)
	interrupt(c, b, 0x10)
	eq(CPU.getReg(c, 0, 8), 0x1a)
	eq(CPU.getReg(c, 3, 16), 8)
end)
check("DPMI descriptors, protected vectors and real-mode simulation", function()
	local c: any, b: any = CPU.new(), Bus.new(0x200000)
	HLE.new(b)
	c.mode32 = true
	c.segmentBases = { [0] = 0 }
	c.ip = 0x123456
	c.flags = 0x202
	c.pspSegment = 0x80
	CPU.setReg(c, 4, 32, 0x180000)
	CPU.setReg(c, 0, 16, 0)
	CPU.setReg(c, 1, 16, 1)
	interrupt(c, b, 0x31)
	local selector = CPU.getReg(c, 0, 16)
	assert(selector ~= 0)
	CPU.setReg(c, 0, 16, 7)
	CPU.setReg(c, 3, 16, selector)
	CPU.setReg(c, 1, 16, 0x12)
	CPU.setReg(c, 2, 16, 0x3456)
	interrupt(c, b, 0x31)
	eq(c.segmentBases[selector], 0x123456)
	local rm = 0x9000
	b:write32(rm + 28, 0x3000)
	b:write16(rm + 32, 0x202)
	CPU.setReg(c, 0, 16, 0x0300)
	CPU.setReg(c, 3, 16, 0x21)
	CPU.setReg(c, 1, 16, 0)
	CPU.setReg(c, 7, 32, rm)
	Interpreter.interrupt(c, b, 0x31)
	for _ = 1, 3 do
		Interpreter.step(c, b)
	end
	eq(c.mode32, true)
	eq(c.ip, 0x123456)
	eq(CPU.getReg(c, 4, 32), 0x180000)
	eq(bit32.band(c.flags, 1), 0)
	eq(b:read32(rm + 28) % 65536, 5)
end)
check("DPMI mode changes cannot dispatch a colliding flat block", function()
	local c: any, b: any = CPU.new(), Bus.new()
	c.ip = 0x1000
	b:load(0x1000, buffer.fromstring(string.char(0xb0, 0x55)))
	local used = false
	local d: any = Dispatcher.new({
		[0x1000] = function(cpu: any, _bus: any, budget: number): (number, number)
			used = true
			cpu.ip += 5
			return CPU.key(cpu), budget - 1
		end,
	}, { mode32 = true })
	d:run(c, b, 1)
	eq(used, false)
	eq(CPU.getReg(c, 0, 8), 0x55)
end)
