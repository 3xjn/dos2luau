--!strict
local CPU = require("../runtime/CPUState")
local Bus = require("../runtime/Bus")
local Interpreter = require("../runtime/Interpreter")
local Dispatcher = require("../runtime/Dispatcher")
local Loader = require("../runtime/Loader")
local VFS = require("../runtime/VFS")
local HLE = require("../runtime/InterruptsAndHLE")
local Video = require("../runtime/Video")
local ParityMeta = require("../runtime/OutParity/Program_Meta")
local ParityBlocks = require("../runtime/OutParity/Blocks_001")
local DemoMeta = require("../runtime/Out/Program_Meta")
local DemoBlocks = require("../runtime/Out/Blocks_001")
local Audio = require("../runtime/Audio")
local Scheduler = require("../runtime/InputAndScheduler")
local DOS = require("../runtime/DOS")
local tests, failures = 0, 0
local function check(name: string, fn: () -> ())
	tests += 1
	local ok, err = pcall(fn)
	if ok then
		print("PASS", name)
	else
		failures += 1
		warn("FAIL " .. name .. ": " .. tostring(err))
	end
end
local function eq(actual: any, expected: any, context: string?)
	assert(actual == expected, (context or "") .. " expected " .. tostring(expected) .. ", got " .. tostring(actual))
end
local function guest(image: string?): (any, any, any)
	local c: any, b: any = CPU.new(), Bus.new()
	local h: any = HLE.new(b)
	Loader.load(c, b, { format = "com", image = image or string.char(0x90, 0xf4), entryIP = 0x100, initialSP = 0xfffe })
	return c, b, h
end
local function interrupt(c: any, b: any, vector: number)
	Interpreter.interrupt(c, b, vector)
	Interpreter.step(c, b)
end
check("register aliases and upper halves", function()
	local c: any = CPU.new()
	CPU.setReg(c, 0, 32, 0x1234abcd)
	eq(CPU.getReg(c, 0, 8), 0xcd)
	eq(CPU.getReg(c, 4, 8), 0xab)
	CPU.setReg(c, 4, 8, 0x55)
	eq(CPU.getReg(c, 0, 32), 0x123455cd)
	CPU.setReg(c, 0, 16, 0xffff)
	eq(CPU.getReg(c, 0, 32), 0x1234ffff)
end)
check("physical and segment word boundary wrapping", function()
	local b: any = Bus.new()
	b:write16(0xfffff, 0x1234)
	eq(b:read8(0xfffff), 0) -- ROM write ignored
	b:load(0xfffff, buffer.fromstring(string.char(0x34, 0x12)))
	eq(b:read16(0xfffff), 0x1234)
	b:writeSeg16(0x1000, 0xffff, 0xabcd)
	eq(b:read8(0x1ffff), 0xcd)
	eq(b:read8(0x10000), 0xab)
	eq(b:readSeg16(0x1000, 0xffff), 0xabcd)
	eq(b.segOffToPhys(0xffff, 0x10010), 0)
end)
check("ALU carry overflow parity and preserved INC carry", function()
	local c: any = CPU.new()
	eq(CPU.alu(c, "add", 0x7fff, 1, 16), 0x8000)
	eq(bit32.band(c.flags, 0x880), 0x880)
	eq(CPU.alu(c, "sub", 0, 1, 16), 0xffff)
	eq(bit32.band(c.flags, 0x95), 0x95)
	CPU.alu(c, "inc", 0xffff, 1, 16)
	eq(bit32.band(c.flags, 0x41), 0x41)
	CPU.alu(c, "adc", 0xffff, 0, 16)
	eq(bit32.band(c.flags, 0x41), 0x41)
end)
check("ModRM BP defaults SS, override DS, signed displacement", function()
	local c, b = guest(string.char(0x8b, 0x46, 0xfe, 0x3e, 0x8b, 0x5e, 0xfe))
	c.ss = 0x2000
	c.ds = 0x3000
	CPU.setReg(c, 5, 16, 0x100)
	b:writeSeg16(c.ss, 0xfe, 0x1234)
	b:writeSeg16(c.ds, 0xfe, 0x5678)
	Interpreter.step(c, b)
	eq(CPU.getReg(c, 0, 16), 0x1234)
	Interpreter.step(c, b)
	eq(CPU.getReg(c, 3, 16), 0x5678)
end)
check("divide error follows IVT and preserves fault IP", function()
	local c, b = guest(string.char(0xf6, 0xf3))
	CPU.setReg(c, 3, 8, 0)
	b:write16(0, 0x123)
	b:write16(2, 0x2222)
	Interpreter.step(c, b)
	eq(c.cs, 0x2222)
	eq(c.ip, 0x123)
	eq(b:readSeg16(c.ss, CPU.getReg(c, 4, 16)), 0x100)
end)
check("IVT stubs and keyboard peek modify saved flags", function()
	local c, b = guest()
	eq(b:read16(0x16 * 4), 0x100 + 0x16 * 4)
	CPU.setReg(c, 0, 16, 0x0100)
	interrupt(c, b, 0x16)
	eq(c.cs, c.loadSegment)
	eq(bit32.band(c.flags, 0x40), 0x40)
	b:write16(0x41e, 0x1e61)
	b:write16(0x41c, 0x20)
	CPU.setReg(c, 0, 16, 0x0100)
	interrupt(c, b, 0x16)
	eq(CPU.getReg(c, 0, 16), 0x1e61)
	eq(bit32.band(c.flags, 0x40), 0)
	eq(b:read16(0x41a), 0x1e)
end)
check("blocking keyboard trap resumes without stacking frames", function()
	local c, b = guest()
	CPU.setReg(c, 0, 16, 0)
	interrupt(c, b, 0x16)
	eq(c.waitingForKey, true)
	local sp = CPU.getReg(c, 4, 16)
	b:write16(0x41e, 0x3062)
	b:write16(0x41c, 0x20)
	c.waitingForKey = false
	c.yieldRequested = false
	Interpreter.step(c, b)
	eq(CPU.getReg(c, 0, 16), 0x3062)
	eq(CPU.getReg(c, 4, 16), (sp + 6) % 65536)
end)
check("PSP, environment trailer, COM RET sentinel and MZ relocation", function()
	local c, b = guest()
	local p = c.pspSegment * 16
	eq(b:read16(p), 0x20cd)
	eq(b:read16(p + 2), 0x9fff)
	local env = b:read16(p + 0x2c) * 16
	eq(b:read8(env), string.byte("C"))
	local loaded: any = CPU.new()
	local ram: any = Bus.new()
	Loader.load(loaded, ram, {
		format = "mz",
		image = string.char(0x34, 0x12, 0x90),
		entryCS = 0,
		entryIP = 2,
		initialSS = 0,
		initialSP = 0x100,
		relocations = { { segment = 0, offset = 0 } },
	}, { loadSegment = 0x2345 })
	eq(ram:read16(0x23450), 0x3579)
	eq(loaded.cs, 0x2345)
	eq(loaded.ip, 2)
end)
check("case-insensitive VFS write, sparse seek and wildcard", function()
	local v: any = VFS.new({ ["DATA/HELLO.TXT"] = "abc" })
	local h, err = v:open("c:\\data\\hello.txt", 2)
	assert(h and not err)
	eq(v:read(h, 2), "ab")
	eq(v:seek(h, 5, 0), 5)
	eq(v:write(h, "Z"), 1)
	eq(v.files["\\DATA\\HELLO.TXT"], "abc\0\0Z")
	eq(#v:find("C:\\DATA\\*.TXT"), 1)
	eq(v:close(h), true)
	eq(v:close(h), false)
end)
check("DOS file errors return carry through IRET", function()
	local c, b = guest()
	CPU.setReg(c, 0, 16, 0x3d00)
	CPU.setReg(c, 2, 16, 0x200)
	b:write8(c.ds * 16 + 0x200, 0)
	interrupt(c, b, 0x21)
	eq(CPU.getReg(c, 0, 16), 2)
	eq(bit32.band(c.flags, 1), 1)
	CPU.setReg(c, 0, 16, 0x3000)
	interrupt(c, b, 0x21)
	eq(CPU.getReg(c, 0, 16), 5)
end)
check("compiled and interpreted parity at every budget boundary", function()
	for budget = 1, 55 do
		local a: any, ab: any = CPU.new(), Bus.new()
		local z: any, zb: any = CPU.new(), Bus.new()
		Loader.load(a, ab, ParityMeta)
		Loader.load(z, zb, ParityMeta)
		Dispatcher.new(ParityBlocks, ParityMeta):run(a, ab, budget)
		Dispatcher.new():run(z, zb, budget)
		eq(buffer.tostring(a.regs), buffer.tostring(z.regs), "registers budget " .. budget)
		eq(a.flags, z.flags, "flags budget " .. budget)
		eq(a.ip, z.ip, "ip budget " .. budget)
		eq(a.cs, z.cs)
		eq(a.halted, z.halted)
		eq(buffer.tostring(ab.ram), buffer.tostring(zb.ram), "RAM budget " .. budget)
	end
end)
check("compiled blocks relocate at multiple load segments", function()
	for _, segment in ipairs({ 0x800, 0x2345, 0x7000 }) do
		local c: any, b: any = CPU.new(), Bus.new()
		Loader.load(c, b, ParityMeta, { loadSegment = segment })
		Dispatcher.new(ParityBlocks, ParityMeta):run(c, b, 200)
		eq(c.halted, true)
		eq(b:readSeg16(segment, 0x300), bit32.bxor(0x8000, 0xaa55))
	end
end)
check("self-modifying code disables compiled blocks", function()
	local c, b = guest(string.char(0xb8, 1, 0, 0xf4))
	local calls = 0
	local blocks: any = {
		[0x100] = function(cpu: any, _bus: any, budget: number): (number, number)
			calls += 1
			CPU.setReg(cpu, 0, 16, 1)
			cpu.ip = 0x103
			return CPU.key(cpu), budget - 1
		end,
	}
	local d: any = Dispatcher.new(blocks, { blockRanges = { [0x100] = { cs = 0, ip = 0x100, length = 3 } } })
	d:run(c, b, 1)
	eq(calls, 1)
	c.ip = 0x100
	b:write8(c.cs * 16 + 0x101, 7)
	d:run(c, b, 1)
	eq(calls, 1)
	eq(CPU.getReg(c, 0, 16), 7)
	eq(c.discoveredBlocks[0x100], true)
end)
check("REP runs in bounded resumable slices", function()
	local c, b = guest(string.char(0xf3, 0xaa, 0xf4))
	CPU.setReg(c, 1, 16, 10)
	CPU.setReg(c, 0, 8, 0x55)
	CPU.setReg(c, 7, 16, 0x300)
	Dispatcher.new():run(c, b, 3)
	eq(c.ip, 0x100)
	eq(CPU.getReg(c, 1, 16), 7)
	eq(CPU.getReg(c, 7, 16), 0x303)
	Dispatcher.new():run(c, b, 8)
	eq(c.halted, true)
	eq(b:read8(c.es * 16 + 0x309), 0x55)
end)
check("video modes, DAC auto increment and planar map mask", function()
	local b: any = Bus.new()
	local v: any = Video.new(b, { headless = true })
	eq(buffer.len(require("../runtime/CP437Font")), 2048)
	v:setMode(0x13)
	b:write8(0xa0000, 4)
	local pixels = v:render()
	eq(buffer.readu32(pixels, 0), buffer.readu32(v.paletteRGBA, 16))
	b:out8(0x3c8, 7)
	b:out8(0x3c9, 63)
	b:out8(0x3c9, 0)
	b:out8(0x3c9, 0)
	eq(b:in8(0x3c8), 8)
	eq(buffer.readu8(v.paletteRGBA, 28), 255)
	eq(bit32.band(bit32.bxor(b:in8(0x3da), b:in8(0x3da)), 9), 9)
	b:out8(0x3c4, 4)
	b:out8(0x3c5, 0)
	b:out8(0x3c4, 2)
	b:out8(0x3c5, 2)
	b:write8(0xa0000, 7)
	pixels = v:render()
	eq(buffer.readu32(pixels, 4), buffer.readu32(v.paletteRGBA, 28))
	eq(buffer.readu32(pixels, 0), buffer.readu32(v.paletteRGBA, 0))
end)
check("precompiled demo reaches graphics and keyboard polling", function()
	local c: any, b: any = CPU.new(), Bus.new()
	local v: any = Video.new(b, { headless = true })
	HLE.new(b, { video = v })
	Loader.load(c, b, DemoMeta)
	local d: any = Dispatcher.new(DemoBlocks, DemoMeta)
	d:run(c, b, 65000)
	eq(v.mode, 0x13)
	assert(b:read8(0xa0000) ~= 0)
	eq(c.halted, false)
end)
check("MZ relocated immediates preserve compiled parity", function()
	local meta: any = require("../runtime/OutMZ/Program_Meta")
	local blocks: any = require("../runtime/OutMZ/Blocks")
	for _, segment in ipairs({ 0x800, 0x2345, 0x7000 }) do
		local c: any, b: any = CPU.new(), Bus.new()
		Loader.load(c, b, meta, { loadSegment = segment })
		Dispatcher.new(blocks, meta):run(c, b, 100)
		eq(c.halted, true)
		eq(c.ds, segment)
		eq(b:readSeg16(segment, 0x300), 15)
	end
end)
check("COFF and LE execute flat compiled blocks with interpreter parity", function()
	local formats = {
		{ meta = require("../runtime/OutCOFF/Program_Meta"), blocks = require("../runtime/OutCOFF/Blocks") },
		{ meta = require("../runtime/OutLE/Program_Meta"), blocks = require("../runtime/OutLE/Blocks") },
	}
	for _, format in ipairs(formats) do
		for budget = 1, 7 do
			local c: any, b: any = CPU.new(), Bus.new(0x2000000)
			local z: any, zb: any = CPU.new(), Bus.new(0x2000000)
			Loader.load(c, b, format.meta)
			Loader.load(z, zb, format.meta)
			Dispatcher.new(format.blocks, format.meta):run(c, b, budget)
			Dispatcher.new():run(z, zb, budget)
			eq(c.ip, z.ip)
			eq(c.flags, z.flags)
			eq(buffer.tostring(c.regs), buffer.tostring(z.regs))
			eq(buffer.tostring(c.regsHigh), buffer.tostring(z.regsHigh))
			eq(b:read32(0x20000), zb:read32(0x20000))
			if budget >= 5 then
				eq(b:read32(0x20000), 0x80000000)
			end
		end
	end
end)
check("32-bit multiplication and division match 128 BigInt oracle vectors", function()
	for _, v in ipairs(require("./fixtures/arithmetic")) do
		local c: any, b: any = CPU.new(), Bus.new(0x200000)
		c.mode32 = true
		c.segmentBases = { [0] = 0 }
		c.ip = 0x1000
		b:load(0x1000, buffer.fromstring(string.char(0xf7, v.op)))
		CPU.setReg(c, 0, 32, v.a)
		CPU.setReg(c, 3, 32, v.b)
		CPU.setReg(c, 2, 32, v.d or 0)
		Interpreter.step(c, b)
		eq(CPU.getReg(c, 0, 32), v.lo, "low")
		eq(CPU.getReg(c, 2, 32), v.hi, "high")
	end
end)
check("32-bit SIB, stack, strings and HLE frame preserve full EIP", function()
	local c: any, b: any = CPU.new(), Bus.new(0x200000)
	HLE.new(b)
	c.mode32 = true
	c.segmentBases = { [0] = 0 }
	c.ip = 0x123450
	c.flags = 0x202
	CPU.setReg(c, 4, 32, 0x180000)
	CPU.setReg(c, 0, 16, 0x3000)
	interrupt(c, b, 0x21)
	eq(c.ip, 0x123450)
	eq(CPU.getReg(c, 4, 32), 0x180000)
	eq(CPU.getReg(c, 0, 16), 5)
	b:load(c.ip, buffer.fromstring(string.char(0x8b, 0x44, 0x8d, 0x10)))
	CPU.setReg(c, 5, 32, 0x100000)
	CPU.setReg(c, 1, 32, 3)
	b:write32(0x10001c, 0x12345678)
	Interpreter.step(c, b)
	eq(CPU.getReg(c, 0, 32), 0x12345678)
	b:load(c.ip, buffer.fromstring(string.char(0xf3, 0xab)))
	CPU.setReg(c, 7, 32, 0x140000)
	CPU.setReg(c, 1, 32, 3)
	for _ = 1, 3 do
		Interpreter.step(c, b)
	end
	eq(b:read32(0x140008), 0x12345678)
	eq(CPU.getReg(c, 1, 32), 0)
end)
check("x87 memory precision, arithmetic and stack pop", function()
	local c, b = guest(string.char(0xd9, 0x06, 0x00, 0x03, 0xd9, 0xe8, 0xde, 0xc1, 0xdd, 0x1e, 0x08, 0x03, 0xf4))
	buffer.writef32(b.ram, c.ds * 16 + 0x300, 2.5)
	Dispatcher.new():run(c, b, 10)
	eq(buffer.readf64(b.ram, c.ds * 16 + 0x308), 3.5)
	eq(c.fpuTop, 0)
end)
check("speaker loops once and changes pitch and gate immediately", function()
	local b: any = Bus.new()
	local s: any = { IsPlaying = false, plays = 0, stops = 0 }
	function s:Play()
		self.IsPlaying = true
		self.plays += 1
	end
	function s:Stop()
		self.IsPlaying = false
		self.stops += 1
	end
	function s:Destroy() end
	local audio: any = Audio.new(b, { headless = true, speakerSound = s })
	eq(s.plays, 1)
	eq(s.Volume, 0)
	b:out8(0x43, 0xb6)
	b:out8(0x42, 0x97)
	b:out8(0x42, 0x0a)
	b:out8(0x61, 3)
	eq(s.Volume, 0.2)
	assert(math.abs(s.PlaybackSpeed - (1193182 / 2711) / 440) < 1e-9)
	b:out8(0x61, 0)
	eq(s.Volume, 0)
	eq(s.plays, 1)
	eq(s.stops, 0)
	audio:destroy()
end)
check("Sound Blaster DMA hash and completion IRQ use exact timing", function()
	local b: any = Bus.new()
	local unknown: any = nil
	local audio: any = Audio.new(b, {
		headless = true,
		onUnknownPCM = function(h: number, n: number)
			unknown = { h, n }
		end,
	})
	b:load(0x10000, buffer.fromstring("hello"))
	b:out8(0x0c, 0)
	b:out8(2, 0)
	b:out8(2, 0)
	b:out8(3, 4)
	b:out8(3, 0)
	b:out8(0x83, 1)
	b:out8(0x0a, 1)
	b:out8(0x226, 1)
	b:out8(0x226, 0)
	eq(b:in8(0x22a), 0xaa)
	b:out8(0x22c, 0x14)
	b:out8(0x22c, 4)
	b:out8(0x22c, 0)
	eq(unknown[1], 0x4f9f2cab)
	eq(unknown[2], 5)
	audio:update(4 / 22050, nil)
	eq(audio.pendingIRQ, nil)
	audio:update(2 / 22050, nil)
	eq(audio.pendingIRQ, 0x0f)
end)
check("keyboard make/break, shift and focus release update BIOS ring", function()
	local c, b = guest()
	local input: any = Scheduler.new(c, b, Dispatcher.new(), { headless = true })
	input:keyEvent("LeftShift", true)
	input:keyEvent("A", true)
	eq(b:read16(0x41e), 0x1e41)
	eq(b:in8(0x60), 0x2a)
	eq(b:in8(0x60), 0x1e)
	input:releaseAll()
	eq(b:read8(0x417), 0)
	eq(next(input.held), nil)
end)
check("scheduler advances PIT every 20000 executed instructions", function()
	local c, b = guest(string.char(0xeb, 0xfe))
	local input: any = Scheduler.new(
		c,
		b,
		Dispatcher.new(),
		{ headless = true, instructionsPerSecond = 40000, frameBudgetSeconds = 1, maxInstructionsPerFrame = 40000 }
	)
	input:step(1)
	eq(input.executedInstructions, 40000)
	eq(input.ticks, 2)
	-- One tick is delivered within the frame; the one at the final boundary is pending.
	eq(b:read32(0x46c) + input.pendingTimer, 2)
end)
check("timer IRQs continue during BIOS key wait and preserve return stack", function()
	local c, b = guest(string.char(0xb4, 0, 0xcd, 0x16, 0xf4))
	local input: any = Scheduler.new(
		c,
		b,
		Dispatcher.new(),
		{ headless = true, frameBudgetSeconds = 1, maxInstructionsPerFrame = 50000 }
	)
	input:step(0.01)
	eq(c.waitingForKey, true)
	local sp = CPU.getReg(c, 4, 16)
	input:step(0.1)
	assert(b:read32(0x46c) >= 1)
	eq(c.waitingForKey, true)
	eq(CPU.getReg(c, 4, 16), sp)
	input:keyEvent("A", true)
	input:step(0.01)
	eq(c.halted, true)
	eq(CPU.getReg(c, 0, 16), 0x1e61)
end)
check("MCB shrink, allocate, free and grow coalesce paragraphs", function()
	local c, b = guest()
	c.es = c.pspSegment
	CPU.setReg(c, 0, 16, 0x4a00)
	CPU.setReg(c, 3, 16, 0x100)
	interrupt(c, b, 0x21)
	eq(bit32.band(c.flags, 1), 0)
	CPU.setReg(c, 0, 16, 0x4800)
	CPU.setReg(c, 3, 16, 0x200)
	interrupt(c, b, 0x21)
	eq(bit32.band(c.flags, 1), 0)
	local allocated = CPU.getReg(c, 0, 16)
	assert(allocated > c.pspSegment)
	c.es = allocated
	CPU.setReg(c, 0, 16, 0x4900)
	interrupt(c, b, 0x21)
	eq(bit32.band(c.flags, 1), 0)
	c.es = c.pspSegment
	CPU.setReg(c, 0, 16, 0x4a00)
	CPU.setReg(c, 3, 16, 0x400)
	interrupt(c, b, 0x21)
	eq(bit32.band(c.flags, 1), 0)
end)
check("runtime assembly, default demo and discovered trace export", function()
