--!strict
local Bus = require("../runtime/Bus")
local Audio = require("../runtime/Audio")
local sample: any = {
	plays = 0,
	Play = function(self: any)
		self.plays += 1
	end,
	Destroy = function() end,
}
local bus = Bus.new()
local audio = Audio.new(bus, { headless = true, speakerSound = sample })
assert(sample.plays == 1 and sample.Volume == 0 and audio.speakerHold == 0)
bus:out8(0x43, 0xb6)
bus:out8(0x42, 0x97)
bus:out8(0x42, 0x0a)
bus:out8(0x61, 3)
assert(audio.speakerActive and audio.speakerHold == 0.05 and audio.lastTriggeredFreq > 440)
assert(sample.TimePosition == 0 and sample.Volume == 0.2)
bus:out8(0x61, 0)
assert(not audio.speakerActive and sample.Volume == 0.2)
audio:update(0.25, nil)
assert(sample.Volume == 0.2, "same-frame elapsed time cannot erase a newly triggered note")
audio:update(0.049, nil)
assert(sample.Volume == 0.2)
audio:setMasterGain(0.5)
assert(sample.Volume == 0.1)
audio:update(0.002, nil)
assert(sample.Volume == 0 and sample.plays == 1)
print("PASS sub-frame speaker pulses survive at least 50 ms and respect master gain")
audio:bell()
assert(audio.speakerHold == 0.08 and sample.PlaybackSpeed == 1 and sample.Volume == 0.1)
audio:update(0.5, nil)
audio:update(0.079, nil)
assert(sample.Volume == 0.1)
audio:update(0.002, nil)
assert(sample.Volume == 0)
bus:out8(0x61, 3)
audio:update(1, nil)
audio:update(1, nil)
assert(audio.speakerActive and sample.Volume == 0.1, "sustained active gate remains audible")
bus:out8(0x61, 0)
audio:update(0.01, nil)
assert(sample.Volume == 0)
assert(Audio.new(Bus.new(), { headless = true }).speaker == nil)
assert(Audio.DEFAULT_SPEAKER_ASSET == "rbxasset://sounds/uuhhh.mp3")
print("PASS bell duration, sustained gates and headless fallback behavior")
